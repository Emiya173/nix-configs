cabal-version: 3.0
name: xlog-hs
version: 0.1.0.0
synopsis: Mars xlog decoder with a functional Haskell core
description: Decode all thirteen legacy and modern Mars xlog record formats.
category: Codec
license: MIT
license-file: LICENSE
author: xlog-hs contributors
maintainer: xlog-hs contributors
build-type: Simple
extra-source-files:
    README.md
    bench/README.md
    bench/RESULTS.md
    bench/PYTHON-RESULTS.md
    bench/samples-20260905.csv
    bench/samples-python-20260905.csv
    test/fixtures/*.xlog
    test/fixtures/*.golden
    test/fixtures/*.bin
    test/fixtures/*.txt

common defaults
    default-language: GHC2021
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    build-depends: base >=4.16 && <5, bytestring >=0.11 && <0.13

library
    import: defaults
    hs-source-dirs: src
    exposed-modules: Xlog, Xlog.Types, Xlog.Format, Xlog.Crypto, Xlog.Decode, Xlog.Native
    other-modules: Xlog.Internal.Key
    build-depends: binary >=0.8 && <0.9
    c-sources: cbits/xlog_native.c
    cc-options: -std=c99 -Wall -Wextra
    pkgconfig-depends: zlib >=1.2.11, libzstd >=1.4.0, libcrypto >=3.0

executable xlog-hs
    import: defaults
    hs-source-dirs: app
    main-is: Main.hs
    build-depends: xlog-hs, directory >=1.3 && <1.4, filepath >=1.4 && <1.6
    ghc-options: -threaded -rtsopts

test-suite xlog-hs-test
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: test, test/support
    main-is: Main.hs
    other-modules: Test.Support
    build-depends: xlog-hs, binary >=0.8 && <0.9
    ghc-options: -threaded

test-suite xlog-hs-cli-test
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: test/cli, test/support
    main-is: Main.hs
    other-modules: Test.Support, Test.Temp
    build-depends:
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        process >=1.6 && <1.7
    build-tool-depends: xlog-hs:xlog-hs
    ghc-options: -threaded

executable generate-fixtures
    import: defaults
    hs-source-dirs: tools/fixtures
    main-is: Main.hs
    other-modules: Fixture.Encode, Fixture.Compression
    build-depends:
        binary >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        text >=1.2 && <2.2
    pkgconfig-depends: zlib >=1.2.11, libzstd >=1.4.0

benchmark migration-bench
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: bench, tools/fixtures, test/support
    main-is: Main.hs
    other-modules: Bench.Corpus, Bench.Report, Fixture.Encode, Fixture.Compression, Test.Temp
    build-depends:
        xlog-hs,
        binary >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        process >=1.6 && <1.7,
        text >=1.2 && <2.2,
        time >=1.9 && <1.15
    build-tool-depends: xlog-hs:xlog-hs
    pkgconfig-depends: zlib >=1.2.11, libzstd >=1.4.0
    ghc-options: -threaded -rtsopts
